{
  "statusLine": {
    "type": "command",
    "command": "node {{ .chezmoi.homeDir | replace `\` "/" }}/.claude/statusline.js"
  },
  "model": "sonnet",
  "env": {
    "DUMB_ZONE_TOKENS": "150000"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ .chezmoi.homeDir | replace `\` "/" }}/.claude/hooks/context-budget.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ .chezmoi.homeDir | replace `\` "/" }}/.claude/hooks/context-budget.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "bevy-skills@bevy-skills": true,
    "superpowers@claude-plugins-official": true,
    "security-guidance@anthropic-plugin-directory": true,
    "feature-dev@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "session-bar@herdr-mods": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "bevy-skills": {
      "source": {
        "source": "github",
        "repo": "chrisgliddon/bevy-skills"
      }
    },
    "herdr-mods": {
      "source": {
        "source": "github",
        "repo": "cybertron288/herdr-mods"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
