{
{{- if eq .chezmoi.os "windows" }}
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File {{ .chezmoi.homeDir | replace `\` "/" }}/.claude/statusline.ps1"
  },
{{- end }}
  "model": "sonnet",
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "bevy-skills@bevy-skills": true,
    "superpowers@claude-plugins-official": true,
    "security-guidance@anthropic-plugin-directory": true,
    "feature-dev@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "session-bar@herdr-mods": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "bevy-skills": {
      "source": {
        "source": "github",
        "repo": "chrisgliddon/bevy-skills"
      }
    },
    "herdr-mods": {
      "source": {
        "source": "github",
        "repo": "cybertron288/herdr-mods"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
