{
{{- if eq .chezmoi.os "windows" }}
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"{{ .chezmoi.homeDir | replace `\` "/" | replace "/" `\\\\` }}\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"{{ .chezmoi.homeDir | replace `\` "/" | replace "/" `\\\\` }}\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"{{ .chezmoi.homeDir | replace `\` "/" }}/.config/herdr-revive/hook.ps1\" -Event start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"{{ .chezmoi.homeDir | replace `\` "/" | replace "/" `\\\\` }}\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"{{ .chezmoi.homeDir | replace `\` "/" | replace "/" `\\\\` }}\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"{{ .chezmoi.homeDir | replace `\` "/" | replace "/" `\\\\` }}\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"{{ .chezmoi.homeDir | replace `\` "/" | replace "/" `\\\\` }}\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"{{ .chezmoi.homeDir | replace `\` "/" }}/.config/herdr-revive/hook.ps1\" -Event end",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir | replace `\` "/" }}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File {{ .chezmoi.homeDir | replace `\` "/" }}/.claude/statusline.ps1"
  },
{{- end }}
  "model": "sonnet",
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "bevy-skills@bevy-skills": true,
    "superpowers@claude-plugins-official": true,
    "security-guidance@anthropic-plugin-directory": true,
    "feature-dev@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "session-bar@herdr-mods": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "bevy-skills": {
      "source": {
        "source": "github",
        "repo": "chrisgliddon/bevy-skills"
      }
    },
    "herdr-mods": {
      "source": {
        "source": "github",
        "repo": "cybertron288/herdr-mods"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop.",
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured - treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: (unknown - origin/HEAD unset, no remotes configured)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured - assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (local checkout at {{ .chezmoi.homeDir | replace `\` "/" | replace "/" `\\` }}\\.claude) only - no remotes are configured, no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar - note: repo contains .credentials.json and security/.no_credentials_notice paths, treat as sensitive-data locations",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured - fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: The local git checkout at {{ .chezmoi.homeDir | replace `\` "/" | replace "/" `\\` }}\\.claude (no remotes configured)",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
